NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Para publicar en GitHub Pages bajo /nombre-del-repo (dejalo vacío si usás
# un dominio propio sin subcarpeta, o si lo seteás solo en el workflow de GitHub Actions):
NEXT_BASE_PATH=

# Los recordatorios por mail y el asistente de IA ya NO viven en esta app
# (se exportó estática para GitHub Pages) — viven como Supabase Edge
# Functions. Sus secrets se configuran en Supabase, no acá:
#   supabase secrets set RESEND_API_KEY=tu-api-key-de-resend
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-tu-key
